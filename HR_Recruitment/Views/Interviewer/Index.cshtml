@model HR_Recruitment.Models.InterviewerDashboardVM
@{
    Layout = "~/views/Shared/_InterviewerLayout.cshtml";
}

<link href="~/assets/css/HrCss.css" rel="stylesheet" />

<!-- ========================= Dashboard Container ==================== -->
<div class="dashboard-container">

    <!-- ========================= Header Bar ==================== -->
    <div class="dashboard-header">
        <div class="header-left">
            <button class="menu-toggle">
                <ion-icon name="menu-outline"></ion-icon>
            </button>
            <h1 class="page-title">Interviewer Dashboard</h1>
        </div>

        <div class="header-center">
            <div class="search-box">
                <ion-icon name="search-outline"></ion-icon>
                <input type="text" placeholder="Search interviews, candidates...">
            </div>
        </div>

        <div class="header-right">
            <button class="notification-btn">
                <ion-icon name="notifications-outline"></ion-icon>
                <span class="badge">@Model.PendingInterviews</span>
            </button>
            <div class="user-profile">
                <img src="~/Admin/assets/imgs/customer01.jpg" alt="User Profile">
                <span class="user-name">Interviewer</span>
            </div>
        </div>
    </div>

    <!-- ======================= Stats Cards Grid ================== -->
    <div class="stats-grid">
        <!-- Row 1: Main Stats -->
        <div class="stat-card stat-card-primary">
            <div class="stat-content">
                <div class="stat-value">@Model.TotalInterviews</div>
                <div class="stat-label">Total Interviews</div>
                <div class="stat-trend">
                    <ion-icon name="calendar-outline"></ion-icon>
                    <span>All assigned</span>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="calendar-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-warning">
            <div class="stat-content">
                <div class="stat-value">@Model.PendingInterviews</div>
                <div class="stat-label">Pending Interviews</div>
                <div class="stat-trend">
                    <ion-icon name="time-outline"></ion-icon>
                    <span>Awaiting decision</span>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="time-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-info">
            <div class="stat-content">
                <div class="stat-value">@Model.CompletedInterviews</div>
                <div class="stat-label">Completed Interviews</div>
                <div class="stat-trend">
                    <ion-icon name="checkmark-done-outline"></ion-icon>
                    <span>Evaluated</span>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="checkmark-done-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-purple">
            <div class="stat-content">
                <div class="stat-value">@Model.TodayInterviews</div>
                <div class="stat-label">Today's Interviews</div>
                <div class="stat-trend">
                    <ion-icon name="today-outline"></ion-icon>
                    <span>Scheduled today</span>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="today-outline"></ion-icon>
            </div>
        </div>

        <!-- Row 2: Results Stats -->
        <div class="stat-card stat-card-success">
            <div class="stat-content">
                <div class="stat-value">@Model.ApprovedCandidates</div>
                <div class="stat-label">Approved Candidates</div>
                <div class="stat-progress">
                    <div class="progress-bar" style="width: @(Model.TotalInterviews > 0 ? (Model.ApprovedCandidates * 100.0 / Model.TotalInterviews) : 0)%;"></div>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-rejected">
            <div class="stat-content">
                <div class="stat-value">@Model.RejectedCandidates</div>
                <div class="stat-label">Rejected Candidates</div>
                <div class="stat-progress">
                    <div class="progress-bar" style="width: @(Model.TotalInterviews > 0 ? (Model.RejectedCandidates * 100.0 / Model.TotalInterviews) : 0)%;"></div>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="close-circle-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-teal">
            <div class="stat-content">
                <div class="stat-value">@(Model.TotalInterviews > 0 ? Math.Round((Model.ApprovedCandidates * 100.0 / Model.TotalInterviews), 1) : 0)%</div>
                <div class="stat-label">Success Rate</div>
                <div class="stat-progress">
                    <div class="progress-bar" style="width: @(Model.TotalInterviews > 0 ? (Model.ApprovedCandidates * 100.0 / Model.TotalInterviews) : 0)%;"></div>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="trending-up-outline"></ion-icon>
            </div>
        </div>

        <div class="stat-card stat-card-orange">
            <div class="stat-content">
                <div class="stat-value">@(Model.TotalInterviews - Model.CompletedInterviews)</div>
                <div class="stat-label">Upcoming Interviews</div>
                <div class="stat-progress">
                    <div class="progress-bar" style="width: 60%;"></div>
                </div>
            </div>
            <div class="stat-icon">
                <ion-icon name="arrow-forward-circle-outline"></ion-icon>
            </div>
        </div>
    </div>

    <!-- ================ Main Content Grid ================= -->
    <div class="content-grid">

        <!-- Recent Interviews Section -->
        <div class="content-card applications-card">
            <div class="card-header">
                <div class="header-left">
                    <h2>Recent Interviews</h2>
                    <span class="count-badge">@(Model.RecentInterviews?.Count() ?? 0) recent</span>
                </div>
                <a asp-action="ScheduledInterviews" asp-controller="Interviewer" class="btn-view-all">
                    View All
                    <ion-icon name="arrow-forward-outline"></ion-icon>
                </a>
            </div>

            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Candidate</th>
                            <th>Position</th>
                            <th>Interview Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentInterviews != null && Model.RecentInterviews.Any())
                        {
                            @foreach (var interview in Model.RecentInterviews)
                            {
                                <tr>
                                    <td>
                                        <div class="applicant-info">
                                            <div class="applicant-avatar">
                                                @interview.ApplicantName.Substring(0, 1).ToUpper()
                                            </div>
                                            <span class="applicant-name">@interview.ApplicantName</span>
                                        </div>
                                    </td>
                                    <td><strong>@interview.JobTitle</strong></td>
                                    <td>@interview.InterviewDate.ToString("MMM dd, yyyy")</td>
                                    <td>@interview.StartTime.ToString(@"hh\:mm") - @interview.EndTime.ToString(@"hh\:mm")</td>
                                    <td>
                                        @if (interview.Result == "Pending")
                                        {
                                            <span class="status-badge status-pending">
                                                <ion-icon name="time-outline"></ion-icon>
                                                Pending
                                            </span>
                                        }
                                        else if (interview.Result == "Selected")
                                        {
                                            <span class="status-badge status-approved">
                                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                                Approved
                                            </span>
                                        }
                                        else if (interview.Result == "Rejected")
                                        {
                                            <span class="status-badge status-rejected">
                                                <ion-icon name="close-circle-outline"></ion-icon>
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-progress">
                                                <ion-icon name="hourglass-outline"></ion-icon>
                                                @interview.Result
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ViewProfile"
                                           asp-controller="Interviewer"
                                           asp-route-applicantVacancyId="@interview.ApplicantVacancyId"
                                           class="btn-action"
                                           title="View Profile">
                                            <ion-icon name="eye-outline"></ion-icon>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="no-data">
                                    <ion-icon name="calendar-outline"></ion-icon>
                                    <p>No recent interviews</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Actions Section -->
        <div class="content-card actions-card">
            <div class="card-header">
                <h2>Quick Actions</h2>
            </div>

            <div class="actions-list">
                <a asp-action="ScheduledInterviews" asp-controller="Interviewer" class="action-item">
                    <div class="action-icon action-primary">
                        <ion-icon name="calendar-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Scheduled Interviews</h4>
                        <p>View all interviews</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a asp-action="ScheduledInterviews" asp-controller="Interviewer" class="action-item">
                    <div class="action-icon action-warning">
                        <ion-icon name="time-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Pending Reviews</h4>
                        <p>@Model.PendingInterviews pending</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a asp-action="ScheduledInterviews" asp-controller="Interviewer" class="action-item">
                    <div class="action-icon action-success">
                        <ion-icon name="checkmark-done-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Completed Interviews</h4>
                        <p>@Model.CompletedInterviews completed</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a asp-action="Index" asp-controller="Interviewer" class="action-item">
                    <div class="action-icon action-info">
                        <ion-icon name="stats-chart-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>My Performance</h4>
                        <p>View statistics</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a asp-action="ScheduledInterviews" asp-controller="Interviewer" class="action-item">
                    <div class="action-icon action-purple">
                        <ion-icon name="today-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Today's Schedule</h4>
                        <p>@Model.TodayInterviews interviews</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a href="#" class="action-item">
                    <div class="action-icon action-teal">
                        <ion-icon name="people-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Candidate Profiles</h4>
                        <p>Browse profiles</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a href="#" class="action-item">
                    <div class="action-icon action-dark">
                        <ion-icon name="document-text-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Interview Notes</h4>
                        <p>Review notes</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>

                <a href="#" class="action-item">
                    <div class="action-icon action-orange">
                        <ion-icon name="help-circle-outline"></ion-icon>
                    </div>
                    <div class="action-content">
                        <h4>Help & Support</h4>
                        <p>Get assistance</p>
                    </div>
                    <ion-icon name="chevron-forward-outline" class="action-arrow"></ion-icon>
                </a>
            </div>
        </div>

    </div>
</div>

<!-- Ionicons -->
<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
