@model HR_Recruitment.Models.Vacancy

<form asp-action="EditVacancy" method="post">
    <input type="hidden" asp-for="VacancyId" />

    <label>Title</label>
    <input asp-for="Title" class="form-control" />

    <label>Department</label>
    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control"></select>

    <label>Total Openings</label>
    <input asp-for="TotalOpenings" class="form-control" />

    <label>Status</label>
    <select asp-for="Status" class="form-control">
        <option>Open</option>
        <option>Closed</option>
    </select>

    <button class="btn btn-success mt-3">Update</button>
</form>
