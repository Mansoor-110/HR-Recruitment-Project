@model HrDashboardVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ========================= Main ==================== -->
<div class="main">
    <div class="topbar">
        <div class="toggle">
            <ion-icon name="menu-outline"></ion-icon>
        </div>

        <div class="search">
            <label>
                <input type="text" placeholder="Search here">
                <ion-icon name="search-outline"></ion-icon>
            </label>
        </div>

        <div class="user">
            <img src="~/Admin/assets/imgs/customer01.jpg" alt="">
        </div>
    </div>

    <!-- ======================= Cards ================== -->
    <div class="cardBox">
        <div class="card">
            <div>
                <div class="numbers">@Model.TotalVacancies</div>
                <div class="cardName">Total Vacancies</div>
            </div>

            <div class="iconBx">
                <ion-icon name="briefcase-outline"></ion-icon>
            </div>
        </div>

        <div class="card">
            <div>
                <div class="numbers">@Model.OpenVacancies</div>
                <div class="cardName">Open Vacancies</div>
            </div>

            <div class="iconBx">
                <ion-icon name="folder-open-outline"></ion-icon>
            </div>
        </div>

        <div class="card">
            <div>
                <div class="numbers">@Model.TotalApplicants</div>
                <div class="cardName">Total Applicants</div>
            </div>

            <div class="iconBx">
                <ion-icon name="people-outline"></ion-icon>
            </div>
        </div>

        <div class="card">
            <div>
                <div class="numbers">@Model.TotalApplications</div>
                <div class="cardName">Total Applications</div>
            </div>

            <div class="iconBx">
                <ion-icon name="document-text-outline"></ion-icon>
            </div>
        </div>
    </div>

    <!-- ======================= Application Stats Cards ================== -->
    <div class="cardBox">
        <div class="card">
            <div>
                <div class="numbers">@Model.PendingApplications</div>
                <div class="cardName">Pending</div>
            </div>

            <div class="iconBx">
                <ion-icon name="time-outline"></ion-icon>
            </div>
        </div>

        <div class="card">
            <div>
                <div class="numbers">@Model.ShortlistedApplications</div>
                <div class="cardName">Selcted Applicants</div>
            </div>

            <div class="iconBx">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
            </div>
        </div>

        <div class="card">
            <div>
                <div class="numbers">@Model.RejectedApplications</div>
                <div class="cardName">Rejected</div>
            </div>

            <div class="iconBx">
                <ion-icon name="close-circle-outline"></ion-icon>
            </div>
        </div>



            <div class="iconBx">
                <ion-icon name="ellipsis-horizontal-circle-outline"></ion-icon>
            </div>
        </div>
    </div>

    <!-- ================ Recent Applications List ================= -->
    <div class="details">
        <div class="recentOrders">
            <div class="cardHeader">
                <h2>Recent Applications</h2>
                <a href="#" class="btn">View All</a>
            </div>

            <table>
                <thead>
                    <tr>
                        <td>Applicant Name</td>
                        <td>Job Title</td>
                        <td>Department</td>
                        <td>Applied Date</td>
                        <td>Status</td>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.RecentApplications != null && Model.RecentApplications.Any())
                    {
                        @foreach (var application in Model.RecentApplications)
                        {
                            <tr>
                                <td>@application.ApplicantName</td>
                                <td>@application.JobTitle</td>
                                <td>@application.DepartmentName</td>
                                <td>@application.AppliedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (application.ApplicationStatus == "Pending")
                                    {
                                        <span class="status pending">@application.ApplicationStatus</span>
                                    }
                                    else if (application.ApplicationStatus == "Shortlisted")
                                    {
                                        <span class="status delivered">@application.ApplicationStatus</span>
                                    }
                                    else if (application.ApplicationStatus == "Rejected")
                                    {
                                        <span class="status return">@application.ApplicationStatus</span>
                                    }
                                    else
                                    {
                                        <span class="status inProgress">@application.ApplicationStatus</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center;">No recent applications</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ================= Quick Actions ================ -->
        <div class="recentCustomers">
            <div class="cardHeader">
                <h2>Quick Actions</h2>
            </div>

            <table>
                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="add-circle-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Post New Vacancy <br> <span>Create job posting</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="people-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>View Applicants <br> <span>Manage candidates</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="document-text-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Review Applications <br> <span>Process submissions</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="briefcase-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Manage Vacancies <br> <span>Edit job postings</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="stats-chart-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>View Reports <br> <span>Analytics & insights</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="settings-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Settings <br> <span>System configuration</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="mail-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Email Templates <br> <span>Manage communications</span></h4>
                    </td>
                </tr>

                <tr>
                    <td width="60px">
                        <div class="imgBx">
                            <ion-icon name="help-circle-outline" style="font-size: 40px; color: var(--blue);"></ion-icon>
                        </div>
                    </td>
                    <td>
                        <h4>Help & Support <br> <span>Get assistance</span></h4>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
