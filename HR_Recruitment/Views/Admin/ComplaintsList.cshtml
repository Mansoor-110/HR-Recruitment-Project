@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model List<HR_Recruitment.Models.Complaint>

<style>
    .complaints-container {
        padding: 30px;
        margin-left: 300px;
        background-color: #F2F2F2;
        min-height: 100vh;
    }

    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            font-size: 32px;
            font-weight: 600;
            color: #333;
            margin: 0;
        }

    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table-header {
        padding: 20px 25px;
        border-bottom: 2px solid #F2F2F2;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .table-header h2 {
            font-size: 20px;
            font-weight: 600;
            color: #333;
            margin: 0;
        }

    .complaints-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .complaints-table thead {
            background-color: #F2F2F2;
            display: none; /* hide header for mobile style */
        }

        .complaints-table tbody tr {
            display: block;
            margin-bottom: 15px;
            border: 1px solid #F2F2F2;
            border-radius: 8px;
            padding: 15px;
            transition: background-color 0.2s ease;
        }

            .complaints-table tbody tr:hover {
                background-color: #FFF5F9;
            }

        .complaints-table tbody td {
            display: block;
            padding: 8px 0;
            border: none;
            font-size: 15px;
            color: #333;
        }

            .complaints-table tbody td:before {
                content: attr(data-label);
                font-weight: 600;
                color: #666;
                display: inline-block;
                width: 120px;
            }

    .btn-delete {
        background-color: #E53E3E;
        color: white;
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 2px 6px rgba(229, 62, 62, 0.2);
    }

        .btn-delete:hover {
            background-color: #C53030;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(197, 48, 48, 0.3);
            color: white;
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

        .empty-state i {
            font-size: 64px;
            color: #DDD;
            margin-bottom: 20px;
        }

        .empty-state p {
            font-size: 18px;
            margin: 0;
        }
</style>

<div class="complaints-container">
    <div class="page-header">
        <h1>Complaints</h1>
    </div>

    <div class="table-card">
        <div class="table-header">
            <h2>All Complaints</h2>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="complaints-table">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Details</th>
                        <th>Created At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var complaint in Model)
                    {
                        <tr>
                            <td data-label="Full Name">@complaint.FullName</td>
                            <td data-label="Email">@complaint.Email</td>
                            <td data-label="Subject">@complaint.Subject</td>
                            <td data-label="Details">@complaint.Details</td>
                            <td data-label="Created At">@complaint.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                            <td data-label="Action">
                                <form asp-action="DeleteComplaint" method="post" onsubmit="return confirm('Are you sure you want to delete this complaint?');" style="display:inline;">
                                    <input type="hidden" name="id" value="@complaint.ComplaintId" />
                                    <button type="submit" class="btn-delete">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>No complaints found</p>
            </div>
        }
    </div>
</div>
