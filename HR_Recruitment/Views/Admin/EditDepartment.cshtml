@model HR_Recruitment.Models.Department

<h3>Edit Department</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="EditDepartment" method="post" class="mt-3">

    <!-- Hidden ID -->
    <input type="hidden" asp-for="DepartmentId" />

    <div class="form-group">
        <label>Department Name</label>
        <input asp-for="DepartmentName" class="form-control" placeholder="Enter department name" required />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Update</button>
        <a asp-action="Departments" class="btn btn-secondary">Cancel</a>
    </div>

</form>
