@model HR_Recruitment.Models.HRApplicantProfileVM
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var returnAction = "Users"; // default
    var returnController = "Admin";

    if (!string.IsNullOrEmpty(returnUrl))
    {
        if (returnUrl == "Applications")
        {
            returnAction = "Applications";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applicant Details</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #F2F2F2;
        }

        .my-apps-container {
            margin-left: 300px;
            padding: 30px;
            background-color: #F2F2F2;
            min-height: 100vh;
        }

        .my-apps-page-header {
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .my-apps-page-header h2 {
                font-size: 32px;
                font-weight: 600;
                color: #333;
                margin: 0 0 8px 0;
            }

            .my-apps-page-header p {
                font-size: 16px;
                color: #666;
                margin: 0;
            }

        .btn-back {
            padding: 10px 20px;
            background-color: #6C757D;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-back:hover {
                background-color: #5A6268;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
                color: white;
                text-decoration: none;
            }

        /* Statistics Cards Row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card-mini {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

            .stat-card-mini.primary {
                border-top: 4px solid #007BFF;
            }

            .stat-card-mini.warning {
                border-top: 4px solid #FFC107;
            }

            .stat-card-mini.success {
                border-top: 4px solid #28A745;
            }

            .stat-card-mini.danger {
                border-top: 4px solid #DC3545;
            }

            .stat-card-mini.info {
                border-top: 4px solid #17A2B8;
            }

        .stat-number {
            font-size: 32px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
        }

        .stat-label {
            font-size: 13px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .profile-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            padding: 30px;
        }

            .profile-card.full-width {
                grid-column: 1 / -1;
            }

        .card-header {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #F2F2F2;
        }

            .card-header h3 {
                font-size: 20px;
                font-weight: 600;
                color: #333;
                margin: 0;
            }

        .info-row {
            display: flex;
            padding: 12px 0;
            border-bottom: 1px solid #F8F9FA;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            font-weight: 600;
            color: #666;
            width: 150px;
            flex-shrink: 0;
            font-size: 14px;
        }

        .info-value {
            color: #333;
            flex: 1;
            font-size: 14px;
        }

        .my-apps-status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            text-align: center;
        }

        .status-applied,
        .status-pending {
            background-color: #FFF3CD;
            color: #856404;
        }

        .status-selected,
        .status-approved,
        .status-active {
            background-color: #D4EDDA;
            color: #155724;
        }

        .status-rejected,
        .status-inactive {
            background-color: #F8D7DA;
            color: #721C24;
        }

        .status-nothprocess {
            background-color: #D1ECF1;
            color: #0C5460;
        }

        .my-apps-table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .my-apps-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

            .my-apps-table thead {
                background-color: #F2F2F2;
            }

                .my-apps-table thead th {
                    padding: 16px 25px;
                    text-align: left;
                    font-weight: 600;
                    font-size: 14px;
                    color: #666;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

            .my-apps-table tbody tr {
                border-bottom: 1px solid #F2F2F2;
                transition: background-color 0.2s ease;
            }

                .my-apps-table tbody tr:hover {
                    background-color: #FFF5F9;
                }

                .my-apps-table tbody tr:last-child {
                    border-bottom: none;
                }

            .my-apps-table tbody td {
                padding: 18px 25px;
                font-size: 15px;
                color: #333;
                vertical-align: middle;
            }

        .my-apps-job-title {
            font-weight: 500;
            color: #222;
        }

        .empty-state-cell {
            text-align: center;
            padding: 60px 20px !important;
            color: #999;
        }

        .empty-state-icon {
            font-size: 48px;
            color: #DDD;
            margin-bottom: 15px;
        }

        .empty-state-text {
            font-size: 16px;
            color: #999;
        }

        .btn-action {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            margin: 0 4px;
            color: white;
        }

        .btn-schedule {
            background-color: #17A2B8;
            box-shadow: 0 2px 6px rgba(23, 162, 184, 0.2);
        }

            .btn-schedule:hover {
                background-color: #138496;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(23, 162, 184, 0.3);
                color: white;
                text-decoration: none;
            }

        /* Responsive Design */
        @@media (max-width: 1200px) {
            .my-apps-container {
                margin-left: 0;
                padding: 20px;
            }

            .stats-row {
                grid-template-columns: repeat(3, 1fr);
            }

            .profile-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .my-apps-page-header {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }

                .my-apps-page-header h2 {
                    font-size: 24px;
                }

            .my-apps-table thead {
                display: none;
            }

            .my-apps-table tbody tr {
                display: block;
                margin-bottom: 15px;
                border: 1px solid #F2F2F2;
                border-radius: 8px;
                padding: 15px;
            }

            .my-apps-table tbody td {
                display: block;
                padding: 8px 0;
                border: none;
                text-align: left !important;
            }

                .my-apps-table tbody td:before {
                    content: attr(data-label);
                    font-weight: 600;
                    color: #666;
                    display: inline-block;
                    width: 120px;
                    text-transform: uppercase;
                    font-size: 12px;
                    letter-spacing: 0.5px;
                }
        }
    </style>
</head>
<body>
    <div class="my-apps-container">
        <div class="my-apps-page-header">
            <div>
                <h2>@Model.FullName</h2>
                <p>Complete Applicant Profile & History</p>
            </div>
            <a asp-action="@returnAction" asp-controller="@returnController" class="btn-back">
                ← Back to @returnAction
            </a>
        </div>

        <!-- Statistics Cards -->
        <div class="stats-row">
            <div class="stat-card-mini primary">
                <div class="stat-number">@Model.TotalApplications</div>
                <div class="stat-label">Total Applications</div>
            </div>
            <div class="stat-card-mini warning">
                <div class="stat-number">@Model.PendingApplications</div>
                <div class="stat-label">Pending</div>
            </div>
            <div class="stat-card-mini success">
                <div class="stat-number">@Model.SelectedApplications</div>
                <div class="stat-label">Selected</div>
            </div>
            <div class="stat-card-mini danger">
                <div class="stat-number">@Model.RejectedApplications</div>
                <div class="stat-label">Rejected</div>
            </div>
            <div class="stat-card-mini info">
                <div class="stat-number">@Model.TotalInterviews</div>
                <div class="stat-label">Interviews</div>
            </div>
        </div>

        <div class="profile-grid">
            <!-- Basic Information -->
            <div class="profile-card">
                <div class="card-header">
                    <h3>📋 Applicant Information</h3>
                </div>
                <div class="info-row">
                    <span class="info-label">Applicant ID:</span>
                    <span class="info-value">@Model.ApplicantId</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Full Name:</span>
                    <span class="info-value">@Model.FullName</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email:</span>
                    <span class="info-value">@Model.Email</span>
                </div>
                <div class="info-row">
                    <span class="info-label">User ID:</span>
                    <span class="info-value">@Model.UserId</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Status:</span>
                    <span class="info-value">
                        @{
                            var statusClass = "my-apps-status-badge ";
                            var statusLower = Model.Status?.ToLower() ?? "";

                            if (statusLower.Contains("active"))
                            {
                                statusClass += "status-active";
                            }
                            else if (statusLower.Contains("inactive"))
                            {
                                statusClass += "status-inactive";
                            }
                            else if (statusLower.Contains("nothprocess"))
                            {
                                statusClass += "status-nothprocess";
                            }
                            else
                            {
                                statusClass += "status-pending";
                            }
                        }
                        <span class="@statusClass">@Model.Status</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Registered On:</span>
                    <span class="info-value">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            <!-- Quick Statistics -->
            <div class="profile-card">
                <div class="card-header">
                    <h3>📊 Application Statistics</h3>
                </div>
                <div class="info-row">
                    <span class="info-label">Total Applications:</span>
                    <span class="info-value"><strong>@Model.TotalApplications</strong> job(s) applied</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Pending Review:</span>
                    <span class="info-value">
                        <span class="my-apps-status-badge status-pending">@Model.PendingApplications</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Selected:</span>
                    <span class="info-value">
                        <span class="my-apps-status-badge status-selected">@Model.SelectedApplications</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Rejected:</span>
                    <span class="info-value">
                        <span class="my-apps-status-badge status-rejected">@Model.RejectedApplications</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Total Interviews:</span>
                    <span class="info-value"><strong>@Model.TotalInterviews</strong> interview(s) conducted</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Success Rate:</span>
                    <span class="info-value">
                        <strong>@(Model.TotalApplications > 0 ? Math.Round((Model.SelectedApplications * 100.0 / Model.TotalApplications), 1) : 0)%</strong>
                    </span>
                </div>
            </div>

            <!-- Application History -->
            <div class="profile-card full-width">
                <div class="card-header">
                    <h3>📜 Application History</h3>
                </div>

                <div class="my-apps-table-container">
                    @if (Model.Applications != null && Model.Applications.Any())
                    {
                        <table class="my-apps-table">
                            <thead>
                                <tr>
                                    <th>Job Position</th>
                                    <th>Department</th>
                                    <th>Applied Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.Applications)
                                {
                                    <tr>
                                        <td class="my-apps-job-title" data-label="Job Position">
                                            @app.JobTitle
                                        </td>
                                        <td data-label="Department">
                                            @app.DepartmentName
                                        </td>
                                        <td data-label="Applied Date">
                                            @app.AppliedDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td data-label="Status">
                                            @{
                                                var appStatusClass = "my-apps-status-badge ";
                                                var appStatusLower = app.Status?.ToLower() ?? "";

                                                if (appStatusLower.Contains("select") || appStatusLower.Contains("approve"))
                                                {
                                                    appStatusClass += "status-selected";
                                                }
                                                else if (appStatusLower.Contains("reject"))
                                                {
                                                    appStatusClass += "status-rejected";
                                                }
                                                else if (appStatusLower.Contains("applied"))
                                                {
                                                    appStatusClass += "status-applied";
                                                }
                                                else
                                                {
                                                    appStatusClass += "status-pending";
                                                }
                                            }
                                            <span class="@appStatusClass">@app.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state-cell">
                            <div class="empty-state-icon">📋</div>
                            <div class="empty-state-text">No application history found.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Interview History -->
            <div class="profile-card full-width">
                <div class="card-header">
                    <h3>🎤 Interview History</h3>
                </div>

                <div class="my-apps-table-container">
                    @if (Model.Interviews != null && Model.Interviews.Any())
                    {
                        <table class="my-apps-table">
                            <thead>
                                <tr>
                                    <th>Job Position</th>
                                    <th>Interviewer</th>
                                    <th>Interview Date</th>
                                    <th>Time</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var interview in Model.Interviews)
                                {
                                    <tr>
                                        <td class="my-apps-job-title" data-label="Job Position">
                                            @interview.JobTitle
                                        </td>
                                        <td data-label="Interviewer">
                                            @interview.InterviewerName
                                        </td>
                                        <td data-label="Interview Date">
                                            @interview.InterviewDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td data-label="Time">
                                            @interview.StartTime.ToString(@"hh\:mm") - @interview.EndTime.ToString(@"hh\:mm")
                                        </td>
                                        <td data-label="Result">
                                            @{
                                                var resultClass = "my-apps-status-badge ";
                                                var resultLower = interview.Result?.ToLower() ?? "";

                                                if (resultLower.Contains("select") || resultLower.Contains("approve"))
                                                {
                                                    resultClass += "status-selected";
                                                }
                                                else if (resultLower.Contains("reject"))
                                                {
                                                    resultClass += "status-rejected";
                                                }
                                                else
                                                {
                                                    resultClass += "status-pending";
                                                }
                                            }
                                            <span class="@resultClass">@interview.Result</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="empty-state-cell">
                            <div class="empty-state-icon">🎤</div>
                            <div class="empty-state-text">No interview history found.</div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</body>
</html>
